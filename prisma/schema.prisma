generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Arquetipo {
  id               String    @id @default(cuid())
  nombre           String    @unique @db.VarChar(20)
  balones          Int       @default(10)
  balonesRugby      Int       @default(0)
  ticketsMundialista Int     @default(0)
  penalizadoHasta   DateTime?
  totalApuestas     Int       @default(0)
  aciertos          Int       @default(0)
  rachaActual       Int       @default(0)
  ultimoAcierto     DateTime?
  createdAt         DateTime  @default(now())
  lastSeen          DateTime  @updatedAt
  ipHash            String?
  bonusDiario       DateTime?
  apuestas          Apuesta[]
}

model Apuesta {
  id           String   @id @default(cuid())
  arquetipoId  String
  arquetipo    Arquetipo @relation(fields: [arquetipoId], references: [id], onDelete: Cascade)
  matchId      String
  tipo         String
  prediccion   Json
  status       String   @default("PENDING")
  costo        Int      @default(1)
  createdAt    DateTime @default(now())
  aciertoBonus Int?     @default(0)

  @@unique([arquetipoId, matchId, tipo])
}

model Match {
  id              String   @id
  date            DateTime
  teamLocal       String
  teamVisita      String
  goalsLocalReal  Int?
  goalsVisitaReal Int?
  status          String   @default("scheduled")
  groupLetter     String?
  stadium         String?
  city            String?
  country         String?
}
